{
  "name": "@iqkv/foundation-docs-website",
  "version": "0.0.0",
  "description": "Project documentation powered by Vitepress.",
  "type": "module",
  "scripts": {
    "ci": "pnpm ci:lint && pnpm ci:test",
    "ci:lint": "pnpm lint",
    "ci:test": "pnpm docs:build",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "lint": "pnpm formatter:check",
    "lint:stylelint": "stylelint \"**/*.css\" --aei",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky",
    "release": "release-it --ci"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "husky": "9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^21.0.2",
    "release-it-pnpm": "^4.6.6",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsdown": "^0.22.14",
    "vitepress": "^1.6.4",
    "vue": "^3.5.42"
  },
  "lint-staged": {
    "*": [
      "pnpm formatter:check"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
